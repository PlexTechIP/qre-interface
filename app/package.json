{
  "name": "microsoft-qre-dashboard-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run --config vitest.workspace.ts",
    "test:engine": "vitest run --config vitest.engine.config.ts --no-file-parallelism --maxWorkers=1",
    "harness": "tsx src/main/harness.ts",
    "acceptance": "tsx src/main/engine/acceptanceHarness.ts",
    "test:all": "vitest run --no-file-parallelism --maxWorkers=1",
    "test:watch": "vitest --config vitest.workspace.ts"
  },
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.1.0",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.4",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  },
  "optionalDependencies": {
    "qsharp-lang": "1.29.1"
  }
}
